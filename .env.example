# ==============================================================================
# JobTrail-AI Production & Local Environment Configuration
# Copy this file to .env and adjust values for your deployment target.
# NEVER commit actual credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI / Render)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# Database Connection URL
# Local SQLite fallback:
DATABASE_URL=sqlite:///./jobtrail.db
# Production Supabase PostgreSQL example:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Security & Authentication
# Generate a secure 64-character secret in production using: openssl rand -hex 32
JWT_SECRET=jobtrail_ai_super_secret_jwt_key_2026_dev_mode_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (NO wildcards in production with credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://jobtrail-ai.vercel.app

# ------------------------------------------------------------------------------
# Supabase Storage Configuration (Resume Files)
# ------------------------------------------------------------------------------
# In production, set your Supabase project URL and private Service Role Key.
# DO NOT expose the service role key to frontend code!
# If left empty, the application falls back to safe local filesystem storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resume-files

# Local file storage fallback path
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite / Vercel)
# ------------------------------------------------------------------------------
# Base URL of the backend API for Vite client requests
# Development: http://localhost:8000
# Production: https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://localhost:8000
